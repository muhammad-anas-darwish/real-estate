APP_NAME="Real Estate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=real_estate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- السيرفر الضعيف (بدون Redis / بدون Queue Worker) ---
# استخدم file لأنه الوحيد الذي يدعم Cache::tags() بجانب redis/memcached
# تنبيه: database لا يدعم Cache::tags() وسيسبب أعطالاً
CACHE_STORE=file

# تنفيذ المهام بشكل متزامن (بدون queue worker)
QUEUE_CONNECTION=sync

# تعطيل البث الحي (Pusher)
BROADCAST_CONNECTION=log

# --- عند الترقية لسيرفر قوي (يدعم Redis + Queue) ---
# قم بتغيير الإعدادات التالية فقط:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# BROADCAST_CONNECTION=pusher
# HORIZON_ENABLED=true
# TELESCOPE_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_URL="${APP_URL}/storage"

# Redis (غير مستخدم حالياً مع CACHE_STORE=file و QUEUE_CONNECTION=sync)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD="your-app-password"
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pusher (غير مستخدم حالياً مع BROADCAST_CONNECTION=log)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https

# Horizon & Telescope (معطلان على السيرفر الضعيف)
HORIZON_ENABLED=false
TELESCOPE_ENABLED=false

# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Location Caching
LOCATION_CITY_CACHE_ENABLED=false
LOCATION_COUNTRY_CACHE_ENABLED=false

# Scribe API Docs
SCRIBE_AUTH_KEY=
