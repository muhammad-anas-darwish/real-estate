    subgraph System["Real Estate Platform"]
        direction TB

        subgraph Auth["Authentication & Browsing"]
            UC1["Register"]
            UC2["Login (Email/Phone/OTP)"]
            UC3["Browse & Search Properties"]
            UC4["View Property Details"]
            UC5["View Map Properties"]
            UC6["View Ads"]
        end

        subgraph User["User Features"]
            UC7["Manage Profile"]
            UC8["Favorite Properties"]
            UC9["Book Appointment/Viewing"]
            UC10["Chat (Direct & Rooms)"]
            UC11["Reviews"]
            UC12["Subscribe to Plan"]
            UC13["Personal File Storage"]
