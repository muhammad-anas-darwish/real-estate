        subgraph Publisher["Publisher Features"]
            UC14["Publish Property"]
            UC15["Edit / Delete Property"]
            UC16["Property Statistics"]
            UC17["Create Ads & Ad Groups"]
            UC18["Ad Performance"]
            UC19["Rental Cards"]
            UC20["Upgrade Request"]
        end

        subgraph Provider["Service Provider Features"]
            UC21["Provider Profile"]
            UC22["Accept Service Requests"]
            UC23["Manage Tasks"]
            UC24["Payroll & Earnings"]
        end

        subgraph Admin["Admin Features"]
            UC25["Users, Roles & Permissions"]
